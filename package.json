{
  "name": "breadcrumb-chat",
  "version": "0.2.0",
  "description": "Drop breadcrumbs from your AI conversations to Slack and beyond",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "breadcrumb": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sinks/slack": {
      "types": "./dist/sinks/slack.d.ts",
      "import": "./dist/sinks/slack.js"
    },
    "./sinks/postgres": {
      "types": "./dist/sinks/postgres.d.ts",
      "import": "./dist/sinks/postgres.js"
    },
    "./sinks/memory": {
      "types": "./dist/sinks/memory.d.ts",
      "import": "./dist/sinks/memory.js"
    },
    "./adapters/ai-sdk": {
      "types": "./dist/adapters/ai-sdk.d.ts",
      "import": "./dist/adapters/ai-sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "slack-manifest.yaml"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npx tsx examples/basic.ts",
    "example:slack": "npx tsx examples/with-slack.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "tracing",
    "observability",
    "slack",
    "openai",
    "anthropic",
    "logging"
  ],
  "author": "Sharan Jhangiani (https://sharanjhangiani.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjhangiani12/breadcrumb.git"
  },
  "homepage": "https://github.com/sjhangiani12/breadcrumb#readme",
  "bugs": {
    "url": "https://github.com/sjhangiani12/breadcrumb/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "ai": ">=4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
